MCP_REQUESTS_PER_MINUTE=18
MCP_AUDIT_LOG=/data/audit/marketplace.jsonl
OAUTH_ENCRYPTION_KEY=replace-with-a-fernet-key
MODEL_PROFILE=open
MODEL_EXECUTION=llm
OLLAMA_BASE_URL=http://ollama:11434
